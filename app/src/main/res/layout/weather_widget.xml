<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/weather_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/open_weather" />

    <TextView
        android:id="@+id/placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg"
        android:gravity="center"
        android:text="@string/widget_placeholder"
        android:textColor="#ffffffff"
        android:textSize="16sp" />

    <!-- Vùng chạm hoàn toàn trong suốt: trái mở app, phải đổi theme — không hiển thị nút nào -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/tap_open_app"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="58"
            android:background="@android:color/transparent"
            android:contentDescription="@string/open_weather" />

        <ImageView
            android:id="@+id/tap_next_theme"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="42"
            android:background="@android:color/transparent"
            android:contentDescription="@string/switch_theme" />
    </LinearLayout>

    <TextView
        android:id="@+id/refresh"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end|bottom"
        android:contentDescription="@string/refresh_weather"
        android:gravity="center"
        android:text="@string/refresh_symbol"
        android:textColor="#ff9df5b8"
        android:textSize="24sp"
        android:visibility="gone" />
</FrameLayout>