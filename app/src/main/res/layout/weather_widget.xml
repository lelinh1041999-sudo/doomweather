<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/weather_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/open_weather" />

    <TextView
        android:id="@+id/placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg"
        android:gravity="center"
        android:text="@string/widget_placeholder"
        android:textColor="#ffffffff"
        android:textSize="16sp" />

    <!-- 3 vùng chạm hoàn toàn trong suốt, không hiển thị nút nào:
         - Góc trên-trái (tên vị trí): cập nhật vị trí GPS
         - Dưới-trái (nhiệt độ & dự báo giờ): mở app
         - Nửa phải (nhân vật): đổi giao diện widget -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="58"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tap_refresh_location"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="28"
                android:background="@android:color/transparent"
                android:contentDescription="@string/refresh_location" />

            <ImageView
                android:id="@+id/tap_open_app"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="72"
                android:background="@android:color/transparent"
                android:contentDescription="@string/open_weather" />
        </LinearLayout>

        <ImageView
            android:id="@+id/tap_next_theme"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="42"
            android:background="@android:color/transparent"
            android:contentDescription="@string/switch_theme" />
    </LinearLayout>

    <TextView
        android:id="@+id/refresh"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end|bottom"
        android:contentDescription="@string/refresh_weather"
        android:gravity="center"
        android:text="@string/refresh_symbol"
        android:textColor="#ff9df5b8"
        android:textSize="24sp"
        android:visibility="gone" />
</FrameLayout>